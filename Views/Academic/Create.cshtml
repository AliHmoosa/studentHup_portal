@model StudentHub.Models.CreateCourseViewModel

@{
    ViewData["Title"] = "Add Course";

    var terms =
        ViewBag.Terms as IReadOnlyList<StudentHub.Models.CourseTermOption>
        ?? [];
}

<link rel="stylesheet"
      href="~/css/CreateCourse.css"
      asp-append-version="true" />

<section class="create-course-page">

    <div class="create-course-header">

        <div>
            <a asp-action="Courses"
               class="back-link">
                ← Back to Courses
            </a>

            <h1>Add Course</h1>

            <p>
                Add your course information and class schedule.
            </p>
        </div>

    </div>


    <form asp-action="Create"
          method="post"
          class="course-form">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="validation-summary">
        </div>


        <!-- COURSE INFORMATION -->

        <section class="form-section">

            <div class="section-heading">

                <h2>Course Information</h2>

                <p>
                    Enter the information for your course.
                </p>

            </div>


            <div class="form-grid">

                <!-- COURSE NAME -->

                <div class="form-group form-group-wide">

                    <label asp-for="Name"></label>

                    <input asp-for="Name"
                           class="form-input"
                           placeholder="e.g. Human Anatomy" />

                    <span asp-validation-for="Name"
                          class="field-validation">
                    </span>

                </div>


                <!-- COURSE CODE -->

                <div class="form-group">

                    <label asp-for="Code"></label>

                    <input asp-for="Code"
                           class="form-input"
                           placeholder="e.g. ANAT 201" />

                    <span asp-validation-for="Code"
                          class="field-validation">
                    </span>

                </div>


                <!-- CREDIT HOURS -->

                <div class="form-group">

                    <label asp-for="CreditHours"></label>

                    <input asp-for="CreditHours"
                           class="form-input"
                           type="number"
                           min="0.5"
                           max="100"
                           step="0.5"
                           placeholder="e.g. 3" />

                    <span asp-validation-for="CreditHours"
                          class="field-validation">
                    </span>

                </div>


                <!-- INSTRUCTOR -->

                <div class="form-group">

                    <label asp-for="Instructor">
                        Instructor
                        <span class="optional-label">Optional</span>
                    </label>

                    <input asp-for="Instructor"
                           class="form-input"
                           placeholder="e.g. Dr. Ahmed Ali" />

                    <span asp-validation-for="Instructor"
                          class="field-validation">
                    </span>

                </div>


                <!-- CATEGORY -->

                <div class="form-group">

                    <label asp-for="Category">
                        Category
                        <span class="optional-label">Optional</span>
                    </label>

                    <div class="select-wrapper">

                        <select asp-for="Category"
                                class="form-input category-select"
                                id="category-select">

                            <option value="">
                                Select category
                            </option>

                            <option value="Computer Science">
                                Computer Science
                            </option>

                            <option value="Information Technology">
                                Information Technology
                            </option>

                            <option value="Software Engineering">
                                Software Engineering
                            </option>

                            <option value="Engineering">
                                Engineering
                            </option>

                            <option value="Business Administration">
                                Business Administration
                            </option>

                            <option value="Accounting">
                                Accounting
                            </option>

                            <option value="Finance">
                                Finance
                            </option>

                            <option value="Economics">
                                Economics
                            </option>

                            <option value="Mathematics">
                                Mathematics
                            </option>

                            <option value="Physics">
                                Physics
                            </option>

                            <option value="Chemistry">
                                Chemistry
                            </option>

                            <option value="Biology">
                                Biology
                            </option>

                            <option value="Medicine & Health Sciences">
                                Medicine & Health Sciences
                            </option>

                            <option value="Law">
                                Law
                            </option>

                            <option value="Education">
                                Education
                            </option>

                            <option value="Psychology">
                                Psychology
                            </option>

                            <option value="Sociology">
                                Sociology
                            </option>

                            <option value="Languages">
                                Languages
                            </option>

                            <option value="Arts & Humanities">
                                Arts & Humanities
                            </option>

                            <option value="Communication & Media">
                                Communication & Media
                            </option>

                            <option value="Architecture">
                                Architecture
                            </option>

                            <option value="Design">
                                Design
                            </option>

                            <option value="Other">
                                Other
                            </option>

                        </select>

                        <span class="select-arrow">
                            ▾
                        </span>

                    </div>

                    <span asp-validation-for="Category"
                          class="field-validation">
                    </span>

                </div>


                <!-- CUSTOM CATEGORY -->

                <div class="form-group"
                     id="custom-category-group"
                     hidden>

                    <label asp-for="CustomCategory">
                        Custom Category
                    </label>

                    <input asp-for="CustomCategory"
                           class="form-input"
                           placeholder="e.g. Marine Sciences" />

                    <span class="form-help">
                        Enter your own category.
                    </span>

                    <span asp-validation-for="CustomCategory"
                          class="field-validation">
                    </span>

                </div>


                <!-- ACADEMIC TERM -->

                <div class="form-group">

                    <label asp-for="TermId"></label>

                    <div class="select-wrapper">

                        <select asp-for="TermId"
                                class="form-input">

                            <option value="">
                                Select academic term
                            </option>

                            @foreach (var term in terms)
                            {
                                <option value="@term.Id">
                                    @term.Name
                                </option>
                            }

                        </select>

                        <span class="select-arrow">
                            ▾
                        </span>

                    </div>

                    <span asp-validation-for="TermId"
                          class="field-validation">
                    </span>

                </div>


                <!-- DESCRIPTION -->

                <div class="form-group form-group-wide">

                    <label asp-for="Description">
                        Description
                        <span class="optional-label">Optional</span>
                    </label>

                    <textarea asp-for="Description"
                              class="form-input form-textarea"
                              rows="5"
                              placeholder="Describe the course..."></textarea>

                    <span class="form-help">
                        Add a short description if you want to keep additional
                        information about this course.
                    </span>

                    <span asp-validation-for="Description"
                          class="field-validation">
                    </span>

                </div>

            </div>

        </section>


        <!-- CLASS SCHEDULE -->

        <section class="form-section">

            <div class="section-heading schedule-heading">

                <div>

                    <h2>Class Schedule</h2>

                    <p>
                        Select the days that share the same class time and location.
                    </p>

                </div>

                <button type="button"
                        id="add-schedule"
                        class="secondary-button">

                    <span class="button-icon">＋</span>

                    Add Class

                </button>

            </div>


            <div id="schedule-container">

                @for (var i = 0; i < Model.Schedules.Count; i++)
                {
                    <div class="schedule-card">

                        <div class="schedule-card-header">

                            <div>

                                <span class="schedule-number">
                                    Class Schedule @(i + 1)
                                </span>

                                <p>
                                    Select one or more days.
                                </p>

                            </div>

                            <button type="button"
                                    class="remove-schedule"
                                    aria-label="Remove class">
                                ×
                            </button>

                        </div>


                        <!-- DAYS -->

                        <div class="schedule-field">

                            <label class="schedule-label">
                                Class Days
                            </label>

                            <div class="day-selector">

                                <label class="day-option">

                                    <input type="checkbox"
                                           name="Schedules[@i].DaysOfWeek"
                                           value="0"
                                           @(Model.Schedules[i].DaysOfWeek.Contains(0)
                                               ? "checked"
                                               : null) />

                                    <span>Sun</span>

                                </label>


                                <label class="day-option">

                                    <input type="checkbox"
                                           name="Schedules[@i].DaysOfWeek"
                                           value="1"
                                           @(Model.Schedules[i].DaysOfWeek.Contains(1)
                                               ? "checked"
                                               : null) />

                                    <span>Mon</span>

                                </label>


                                <label class="day-option">

                                    <input type="checkbox"
                                           name="Schedules[@i].DaysOfWeek"
                                           value="2"
                                           @(Model.Schedules[i].DaysOfWeek.Contains(2)
                                               ? "checked"
                                               : null) />

                                    <span>Tue</span>

                                </label>


                                <label class="day-option">

                                    <input type="checkbox"
                                           name="Schedules[@i].DaysOfWeek"
                                           value="3"
                                           @(Model.Schedules[i].DaysOfWeek.Contains(3)
                                               ? "checked"
                                               : null) />

                                    <span>Wed</span>

                                </label>


                                <label class="day-option">

                                    <input type="checkbox"
                                           name="Schedules[@i].DaysOfWeek"
                                           value="4"
                                           @(Model.Schedules[i].DaysOfWeek.Contains(4)
                                               ? "checked"
                                               : null) />

                                    <span>Thu</span>

                                </label>


                                <label class="day-option">

                                    <input type="checkbox"
                                           name="Schedules[@i].DaysOfWeek"
                                           value="5"
                                           @(Model.Schedules[i].DaysOfWeek.Contains(5)
                                               ? "checked"
                                               : null) />

                                    <span>Fri</span>

                                </label>


                                <label class="day-option">

                                    <input type="checkbox"
                                           name="Schedules[@i].DaysOfWeek"
                                           value="6"
                                           @(Model.Schedules[i].DaysOfWeek.Contains(6)
                                               ? "checked"
                                               : null) />

                                    <span>Sat</span>

                                </label>

                            </div>

                        </div>


                        <!-- TIME + LOCATION -->

                        <div class="schedule-details">

                            <div class="schedule-field">

                                <label class="schedule-label">
                                    Start Time
                                </label>

                                <div class="time-input-wrapper">

                                    <span class="time-icon">
                                        ◷
                                    </span>

                                    <input type="time"
                                           name="Schedules[@i].StartTime"
                                           value="@Model.Schedules[i].StartTime?.ToString(@"hh\:mm")"
                                           class="time-input" />

                                </div>

                            </div>


                            <div class="time-separator">
                                →
                            </div>


                            <div class="schedule-field">

                                <label class="schedule-label">
                                    End Time
                                </label>

                                <div class="time-input-wrapper">

                                    <span class="time-icon">
                                        ◷
                                    </span>

                                    <input type="time"
                                           name="Schedules[@i].EndTime"
                                           value="@Model.Schedules[i].EndTime?.ToString(@"hh\:mm")"
                                           class="time-input" />

                                </div>

                            </div>


                            <div class="schedule-field location-field">

                                <label class="schedule-label">
                                    Location
                                    <span class="optional-label">
                                        Optional
                                    </span>
                                </label>

                                <input type="text"
                                       name="Schedules[@i].Location"
                                       value="@Model.Schedules[i].Location"
                                       class="form-input"
                                       placeholder="e.g. Room 201" />

                            </div>

                        </div>

                    </div>
                }

            </div>

        </section>


        <!-- ACTIONS -->

        <div class="form-actions">

            <a asp-action="Courses"
               class="cancel-button">
                Cancel
            </a>

            <button type="submit"
                    class="primary-button">
                Save Course
            </button>

        </div>

    </form>

</section>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        (() => {

            const container =
                document.getElementById("schedule-container");

            const addButton =
                document.getElementById("add-schedule");

            const categorySelect =
                document.getElementById("category-select");

            const customCategoryGroup =
                document.getElementById("custom-category-group");


            /*
             * CATEGORY
             */

            function updateCustomCategory() {

                if (!categorySelect || !customCategoryGroup) {
                    return;
                }

                const isOther =
                    categorySelect.value === "Other";

                customCategoryGroup.hidden =
                    !isOther;

                if (!isOther) {

                    const input =
                        customCategoryGroup.querySelector("input");

                    if (input) {
                        input.value = "";
                    }

                }

            }


            if (categorySelect) {

                categorySelect.addEventListener(
                    "change",
                    updateCustomCategory);

                updateCustomCategory();

            }


            /*
             * SCHEDULE INDEXES
             */

            function updateIndexes() {

                const cards =
                    container.querySelectorAll(".schedule-card");

                cards.forEach((card, index) => {

                    card.querySelectorAll("[name]").forEach(input => {

                        input.name =
                            input.name.replace(
                                /Schedules\[\d+\]/g,
                                `Schedules[${index}]`
                            );

                    });

                    const number =
                        card.querySelector(".schedule-number");

                    if (number) {

                        number.textContent =
                            `Class Schedule ${index + 1}`;

                    }

                });

            }


            /*
             * CREATE SCHEDULE
             */

            function createScheduleCard() {

                const index =
                    container.querySelectorAll(".schedule-card").length;

                const card =
                    document.createElement("div");

                card.className =
                    "schedule-card";

                card.innerHTML = `

                    <div class="schedule-card-header">

                        <div>

                            <span class="schedule-number">
                                Class Schedule ${index + 1}
                            </span>

                            <p>
                                Select one or more days.
                            </p>

                        </div>

                        <button type="button"
                                class="remove-schedule"
                                aria-label="Remove class">
                            ×
                        </button>

                    </div>


                    <div class="schedule-field">

                        <label class="schedule-label">
                            Class Days
                        </label>

                        <div class="day-selector">

                            <label class="day-option">

                                <input type="checkbox"
                                       name="Schedules[${index}].DaysOfWeek"
                                       value="0" />

                                <span>Sun</span>

                            </label>


                            <label class="day-option">

                                <input type="checkbox"
                                       name="Schedules[${index}].DaysOfWeek"
                                       value="1" />

                                <span>Mon</span>

                            </label>


                            <label class="day-option">

                                <input type="checkbox"
                                       name="Schedules[${index}].DaysOfWeek"
                                       value="2" />

                                <span>Tue</span>

                            </label>


                            <label class="day-option">

                                <input type="checkbox"
                                       name="Schedules[${index}].DaysOfWeek"
                                       value="3" />

                                <span>Wed</span>

                            </label>


                            <label class="day-option">

                                <input type="checkbox"
                                       name="Schedules[${index}].DaysOfWeek"
                                       value="4" />

                                <span>Thu</span>

                            </label>


                            <label class="day-option">

                                <input type="checkbox"
                                       name="Schedules[${index}].DaysOfWeek"
                                       value="5" />

                                <span>Fri</span>

                            </label>


                            <label class="day-option">

                                <input type="checkbox"
                                       name="Schedules[${index}].DaysOfWeek"
                                       value="6" />

                                <span>Sat</span>

                            </label>

                        </div>

                    </div>


                    <div class="schedule-details">

                        <div class="schedule-field">

                            <label class="schedule-label">
                                Start Time
                            </label>

                            <div class="time-input-wrapper">

                                <span class="time-icon">
                                    ◷
                                </span>

                                <input type="time"
                                       name="Schedules[${index}].StartTime"
                                       class="time-input" />

                            </div>

                        </div>


                        <div class="time-separator">
                            →
                        </div>


                        <div class="schedule-field">

                            <label class="schedule-label">
                                End Time
                            </label>

                            <div class="time-input-wrapper">

                                <span class="time-icon">
                                    ◷
                                </span>

                                <input type="time"
                                       name="Schedules[${index}].EndTime"
                                       class="time-input" />

                            </div>

                        </div>


                        <div class="schedule-field location-field">

                            <label class="schedule-label">
                                Location
                                <span class="optional-label">
                                    Optional
                                </span>
                            </label>

                            <input type="text"
                                   name="Schedules[${index}].Location"
                                   class="form-input"
                                   placeholder="e.g. Room 201" />

                        </div>

                    </div>
                `;

                container.appendChild(card);

            }


            addButton.addEventListener(
                "click",
                createScheduleCard);


            /*
             * REMOVE SCHEDULE
             */

            container.addEventListener(
                "click",
                event => {

                    const button =
                        event.target.closest(".remove-schedule");

                    if (!button) {
                        return;
                    }

                    const cards =
                        container.querySelectorAll(".schedule-card");

                    if (cards.length === 1) {
                        return;
                    }

                    button.closest(".schedule-card").remove();

                    updateIndexes();

                });

        })();

    </script>
}