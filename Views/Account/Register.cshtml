@model StudentHub.Models.RegisterViewModel

@{
    ViewData["Title"] = "Create Your Account";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - StudentHub</title>

    <link rel="stylesheet" href="~/css/SignUp.css" asp-append-version="true" />
</head>

<body>

    <main class="signup-page">

        <!-- LEFT BRAND PANEL -->
        <section class="brand-panel">

            <div class="brand-content">

                <a class="brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">
                        <svg viewBox="0 0 64 64" aria-hidden="true">
                            <path d="M32 5 5 19l27 14 27-14L32 5Z" />
                            <path d="M13 28v15l19 10 19-10V28L32 38 13 28Z" />
                            <path d="M32 33v23" />
                            <path d="M43 25v19" />
                            <circle cx="48" cy="44" r="3" />
                        </svg>
                    </span>

                    <span class="brand-name">
                        Student<span>Hub</span>
                    </span>
                </a>

                <p class="brand-tagline">
                    Your Academic Journey In One Place
                </p>

                <div class="brand-message">
                    <h1>
                        A Smarter Way<br />
                        to <span>Your Future</span>
                    </h1>

                    <p>
                        Join thousands of students who organize,
                        plan and achieve their academic goals with
                        StudentHub.
                    </p>
                </div>

                <div class="feature-grid">

                    <div class="feature-item">
                        <span class="feature-icon">
                            <svg viewBox="0 0 24 24">
                                <rect x="3" y="4" width="18" height="17" rx="2" />
                                <path d="M7 2v4M17 2v4M3 9h18" />
                                <path d="M8 13h2M14 13h2M8 17h2M14 17h2" />
                            </svg>
                        </span>
                        <span>Manage<br />Your Schedule</span>
                    </div>

                    <div class="feature-item">
                        <span class="feature-icon">
                            <svg viewBox="0 0 24 24">
                                <path d="M3 6h18v12H3z" />
                                <path d="m3 6 9 6 9-6" />
                            </svg>
                        </span>
                        <span>Plan<br />Your Degree</span>
                    </div>

                    <div class="feature-item">
                        <span class="feature-icon">
                            <svg viewBox="0 0 24 24">
                                <path d="M5 3h14v18H5z" />
                                <path d="M8 7h8M8 11h8M8 15h5" />
                            </svg>
                        </span>
                        <span>Track<br />Assignments</span>
                    </div>

                    <div class="feature-item">
                        <span class="feature-icon">
                            <svg viewBox="0 0 24 24">
                                <path d="M5 3h14v18H5z" />
                                <path d="M8 3v18M16 3v18" />
                            </svg>
                        </span>
                        <span>Access<br />Study Resources</span>
                    </div>

                    <div class="feature-item">
                        <span class="feature-icon">
                            <svg viewBox="0 0 24 24">
                                <path d="M4 19V9M10 19V5M16 19v-8M22 19H2" />
                                <path d="m3 7 6-3 6 2 6-4" />
                            </svg>
                        </span>
                        <span>Calculate<br />Your GPA</span>
                    </div>

                    <div class="feature-item">
                        <span class="feature-icon">
                            <svg viewBox="0 0 24 24">
                                <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />
                                <path d="M10 21h4" />
                            </svg>
                        </span>
                        <span>Stay<br />Organized</span>
                    </div>

                </div>

                <div class="brand-quote">
                    <p>
                        “A better tomorrow<br />
                        starts with what you do today.”
                    </p>
                    <span></span>
                </div>

            </div>

            <div class="campus-image">
                <div class="campus-overlay"></div>

                <div class="campus-placeholder">
                    <div class="campus-arch"></div>
                    <div class="campus-ground"></div>
                </div>

                <div class="campus-caption">
                    <span>KNOWLEDGE</span>
                    <span>BUILDS</span>
                    <span>BRIGHTER</span>
                    <span>TOMORROWS</span>
                </div>
            </div>

        </section>


        <!-- RIGHT FORM PANEL -->
        <section class="form-panel">

            <div class="language-selector">
                <span class="globe">
                    <svg viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M3 12h18" />
                        <path d="M12 3c3 3 3 15 0 18" />
                        <path d="M12 3c-3 3-3 15 0 18" />
                    </svg>
                </span>

                <span>English</span>

                <svg class="chevron" viewBox="0 0 24 24">
                    <path d="m7 10 5 5 5-5" />
                </svg>
            </div>

            <div class="signup-card">

                <div class="form-heading">
                    <h2>Create Your Account</h2>
                    <p>
                        Join StudentHub and start your academic journey
                    </p>
                </div>

                <form asp-action="Register"
                      asp-controller="Account"
                      method="post"
                      class="signup-form">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="validation-summary">
                    </div>

                    <div class="form-row">

                        <!-- FULL NAME -->
                        <div class="form-group">

                            <label asp-for="DisplayName">
                                Full Name
                            </label>

                            <div class="input-wrapper">

                                <svg class="input-icon" viewBox="0 0 24 24">
                                    <circle cx="12" cy="8" r="4" />
                                    <path d="M4 21c0-4 3-7 8-7s8 3 8 7" />
                                </svg>

                                <input asp-for="DisplayName"
                                       placeholder="Enter your full name"
                                       autocomplete="name" />

                            </div>

                            <span asp-validation-for="DisplayName"
                                  class="field-error">
                            </span>

                        </div>


                        <!-- EMAIL -->
                        <div class="form-group">

                            <label asp-for="Email">
                                Email Address
                            </label>

                            <div class="input-wrapper">

                                <svg class="input-icon" viewBox="0 0 24 24">
                                    <rect x="3" y="5" width="18" height="14" rx="2" />
                                    <path d="m3 7 9 7 9-7" />
                                </svg>

                                <input asp-for="Email"
                                       placeholder="Enter your university email"
                                       autocomplete="email" />

                            </div>

                            <span asp-validation-for="Email"
                                  class="field-error">
                            </span>

                        </div>

                    </div>


                    <!-- PASSWORD -->
                    <div class="form-group">

                        <label asp-for="Password">
                            Password
                        </label>

                        <div class="input-wrapper">

                            <svg class="input-icon" viewBox="0 0 24 24">
                                <rect x="5" y="10" width="14" height="10" rx="2" />
                                <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                            </svg>

                            <input asp-for="Password"
                                   id="password"
                                   placeholder="Create a password"
                                   autocomplete="new-password" />

                            <button type="button"
                                    class="password-toggle"
                                    data-target="password"
                                    aria-label="Show password">

                                <svg viewBox="0 0 24 24">
                                    <path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12Z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>

                            </button>

                        </div>

                        <p class="input-help">
                            Use at least 8 characters with a mix of letters,
                            numbers and symbols.
                        </p>

                        <span asp-validation-for="Password"
                              class="field-error">
                        </span>

                    </div>


                    <!-- CONFIRM PASSWORD -->
                    <div class="form-group">

                        <label asp-for="ConfirmPassword">
                            Confirm Password
                        </label>

                        <div class="input-wrapper">

                            <svg class="input-icon" viewBox="0 0 24 24">
                                <rect x="5" y="10" width="14" height="10" rx="2" />
                                <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                            </svg>

                            <input asp-for="ConfirmPassword"
                                   id="confirmPassword"
                                   placeholder="Confirm your password"
                                   autocomplete="new-password" />

                            <button type="button"
                                    class="password-toggle"
                                    data-target="confirmPassword"
                                    aria-label="Show password">

                                <svg viewBox="0 0 24 24">
                                    <path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12Z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>

                            </button>

                        </div>

                        <span asp-validation-for="ConfirmPassword"
                              class="field-error">
                        </span>

                    </div>


                    <!-- UNIVERSITY -->
                    <div class="form-group">

                        <label asp-for="University">
                            University
                        </label>

                        <div class="select-wrapper">

                            <svg class="input-icon" viewBox="0 0 24 24">
                                <path d="M3 10 12 4l9 6" />
                                <path d="M5 10v9h14v-9" />
                                <path d="M3 19h18" />
                                <path d="M8 13v3M12 13v3M16 13v3" />
                            </svg>

                            <select asp-for="University">

                                <option value="">
                                    Select your university
                                </option>

                                <option value="Arabian Gulf University">
                                    Arabian Gulf University
                                </option>

                            </select>

                            <svg class="select-chevron" viewBox="0 0 24 24">
                                <path d="m7 10 5 5 5-5" />
                            </svg>

                        </div>

                        <span asp-validation-for="University"
                              class="field-error">
                        </span>

                    </div>


                    <!-- TERMS -->
                    <div class="terms-row">

                        <input asp-for="AcceptTerms"
                               id="AcceptTerms"
                               type="checkbox" />

                        <label for="AcceptTerms">
                            I agree to the
                            <a href="#">Terms of Service</a>
                            and
                            <a href="#">Privacy Policy</a>
                        </label>

                    </div>

                    <span asp-validation-for="AcceptTerms"
                          class="field-error terms-error">
                    </span>


                    <!-- CREATE ACCOUNT -->
                    <button type="submit"
                            class="create-account-button">

                        <span>Create Account</span>

                        <svg viewBox="0 0 24 24">
                            <path d="M5 12h14" />
                            <path d="m13 6 6 6-6 6" />
                        </svg>

                    </button>


                    <!-- DIVIDER -->
                    <div class="divider">
                        <span></span>
                        <b>or</b>
                        <span></span>
                    </div>


                    <!-- GOOGLE -->
                    <button type="button"
                            class="google-button"
                            onclick="location.href='@Url.Action("ExternalLogin", "Account", new { provider = "Google", returnUrl = "/Dashboard" })'">

                        <span class="google-logo">G</span>

                        <span>Continue with Google</span>

                    </button>


                    <!-- LOGIN -->
                    <p class="login-link">
                        Already have an account?

                        <form asp-controller="Account"
                            asp-action="ExternalLogin"
                            method="post"
                            class="google-login-form">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                name="provider"
                                value="Google" />

                            <input type="hidden"
                                name="returnUrl"
                                value="/Dashboard" />

                            <button type="submit"
                                    class="google-button">

                                <span class="google-logo">G</span>

                                <span>Continue with Google</span>

                            </button>

                        </form>
                    </p>

                </form>

            </div>

        </section>

    </main>


    <script>

        document.querySelectorAll(".password-toggle").forEach(button => {

            button.addEventListener("click", function () {

                const targetId = this.dataset.target;
                const input = document.getElementById(targetId);

                if (!input) {
                    return;
                }

                if (input.type === "password") {

                    input.type = "text";

                    this.setAttribute(
                        "aria-label",
                        "Hide password"
                    );

                } else {

                    input.type = "password";

                    this.setAttribute(
                        "aria-label",
                        "Show password"
                    );
                }

            });

        });

    </script>


    @if (ViewData.ModelState.ErrorCount > 0)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const firstError = document.querySelector(".field-error:not(:empty), .validation-summary:not(:empty)");

                if (firstError) {
                    firstError.scrollIntoView({
                        behavior: "smooth",
                        block: "center"
                    });
                }
            });
        </script>
    }

</body>
</html>