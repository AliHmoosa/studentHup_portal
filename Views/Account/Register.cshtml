@model RegisterViewModel
@{ ViewData["Title"] = "Create account"; }
<section class="form-page"><h1>Create your account</h1><p>Your academic workspace starts here.</p><form asp-action="Register" method="post" class="form-card"><div asp-validation-summary="ModelOnly"></div><label>Full name<input asp-for="DisplayName" autocomplete="name" /></label><label>Email<input asp-for="Email" autocomplete="email" /></label><label>Password<input asp-for="Password" autocomplete="new-password" /></label><label>Confirm password<input asp-for="ConfirmPassword" autocomplete="new-password" /></label><button class="primary-button" type="submit">Create account</button><p>Already have an account? <a asp-action="Login">Sign in</a></p></form></section>
