@{
    ViewData["Title"] = "Check Your Email";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Check Your Email - StudentHub</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" />

    <link rel="stylesheet"
          href="~/css/Login.css"
          asp-append-version="true" />

</head>

<body>

<main class="auth-page">

    <section class="auth-brand-panel">

        <div class="brand-background"></div>

        <div class="brand-content">

            <a class="brand-logo"
               asp-controller="Account"
               asp-action="Login">

                <span class="brand-icon">
                    🎓
                </span>

                <span class="brand-name">
                    Student<span>Hub</span>
                </span>

            </a>

            <p class="brand-tagline">
                Your Academic Journey In One Place
            </p>

            <div class="brand-introduction">

                <h1>
                    Plan. Learn.
                    <span>Achieve.</span>
                </h1>

                <p>
                    Your academic journey is always within reach.
                </p>

            </div>

        </div>

    </section>


    <section class="auth-form-panel">

        <div class="login-card">

            <div class="login-heading">

                <div style="
                    font-size:48px;
                    margin-bottom:18px;">
                    ✉️
                </div>

                <h2>
                    Check Your Email
                </h2>

                <p>
                    If an account exists with that email,
                    we've sent you a password reset link.
                </p>

            </div>


            <a asp-controller="Account"
               asp-action="Login"
               class="login-button"
               style="
                   margin-top:30px;
                   text-decoration:none;">
                <span>
                    Back to Login
                </span>

                <span class="button-arrow">
                    →
                </span>
            </a>

        </div>

    </section>

</main>

</body>
</html>