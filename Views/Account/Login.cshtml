@model LoginViewModel
@{ ViewData["Title"] = "Sign in"; }
<section class="form-page"><h1>Welcome back</h1><p>Sign in to continue your academic journey.</p><form asp-action="Login" method="post" class="form-card"><div asp-validation-summary="ModelOnly"></div><label>Email<input asp-for="Email" autocomplete="email" /></label><label>Password<input asp-for="Password" autocomplete="current-password" /></label><label><input asp-for="RememberMe" /> Remember me</label><button class="primary-button" type="submit">Sign in</button><p>New to StudentHub? <a asp-action="Register">Create an account</a></p></form></section>
