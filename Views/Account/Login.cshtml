@model StudentHub.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Login - StudentHub</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" />

    <link rel="stylesheet"
          href="~/css/Login.css"
          asp-append-version="true" />

</head>

<body>

    <main class="auth-page">

        <!-- =================================================
             LEFT BRAND PANEL
             ================================================= -->

        <section class="auth-brand-panel">

            <div class="brand-background"></div>

            <div class="brand-content">

                <a class="brand-logo"
                   asp-controller="Account"
                   asp-action="Login">

                    <span class="brand-icon">

                        <svg viewBox="0 0 64 64"
                             aria-hidden="true">

                            <path d="M8 23 32 10l24 13-24 13L8 23Z" />

                            <path d="M17 28v13l15 9 15-9V28" />

                            <path d="M52 25v13" />

                            <circle cx="52"
                                    cy="41"
                                    r="2.5" />

                            <path d="M24 36v10" />

                        </svg>

                    </span>

                    <span class="brand-name">
                        Student<span>Hub</span>
                    </span>

                </a>


                <p class="brand-tagline">
                    Your Academic Journey In One Place
                </p>


                <div class="brand-introduction">

                    <h1>
                        Plan. Learn.
                        <span>Achieve.</span>
                    </h1>

                    <p>
                        All the tools you need to manage your
                        university life, in one place.
                    </p>

                </div>


                <div class="feature-grid">

                    <div class="feature-item">

                        <span class="feature-icon">
                            📅
                        </span>

                        <span>
                            Manage<br />
                            Your Schedule
                        </span>

                    </div>


                    <div class="feature-item">

                        <span class="feature-icon">
                            🎓
                        </span>

                        <span>
                            Plan<br />
                            Your Degree
                        </span>

                    </div>


                    <div class="feature-item">

                        <span class="feature-icon">
                            📄
                        </span>

                        <span>
                            Track<br />
                            Assignments
                        </span>

                    </div>


                    <div class="feature-item">

                        <span class="feature-icon">
                            📖
                        </span>

                        <span>
                            Access<br />
                            Study Resources
                        </span>

                    </div>


                    <div class="feature-item">

                        <span class="feature-icon">
                            📊
                        </span>

                        <span>
                            Calculate<br />
                            Your GPA
                        </span>

                    </div>


                    <div class="feature-item">

                        <span class="feature-icon">
                            🔔
                        </span>

                        <span>
                            Stay<br />
                            Updated
                        </span>

                    </div>

                </div>


                <div class="brand-quote">

                    <p>
                        “A better tomorrow<br />
                        starts with what you do today.”
                    </p>

                    <span></span>

                </div>

            </div>

        </section>


        <!-- =================================================
             RIGHT LOGIN PANEL
             ================================================= -->

        <section class="auth-form-panel">


            <!-- Language -->
            <div class="language-selector">

                <span>◎</span>

                <span>English</span>

                <span>⌄</span>

            </div>


            <div class="login-card">

                <div class="login-heading">

                    <h2>
                        Welcome Back
                    </h2>

                    <p>
                        Log in to your StudentHub account
                    </p>

                </div>


                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="validation-summary">
                        @Html.ValidationSummary(
                            true,
                            "",
                            new { @class = "validation-list" })
                    </div>
                }


                <form asp-controller="Account"
                      asp-action="Login"
                      method="post"
                      class="login-form">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           asp-for="ReturnUrl" />


                    <!-- Email -->

                    <div class="form-group">

                        <label asp-for="Email">
                            Email Address
                        </label>

                        <div class="input-wrapper">

                            <span class="input-icon">

                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true">

                                    <rect x="3"
                                          y="5"
                                          width="18"
                                          height="14"
                                          rx="2" />

                                    <path d="m3 7 9 6 9-6" />

                                </svg>

                            </span>

                            <input asp-for="Email"
                                   autocomplete="email"
                                   placeholder="Enter your university email" />

                        </div>

                        <span asp-validation-for="Email"
                              class="field-error">
                        </span>

                    </div>


                    <!-- Password -->

                    <div class="form-group">

                        <label asp-for="Password">
                            Password
                        </label>

                        <div class="input-wrapper">

                            <span class="input-icon">

                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true">

                                    <rect x="5"
                                          y="10"
                                          width="14"
                                          height="10"
                                          rx="2" />

                                    <path d="M8 10V7a4 4 0 0 1 8 0v3" />

                                </svg>

                            </span>

                            <input asp-for="Password"
                                   id="passwordInput"
                                   autocomplete="current-password"
                                   placeholder="Enter your password"
                                   type="password" />

                            <button type="button"
                                    class="password-toggle"
                                    id="passwordToggle"
                                    aria-label="Show password">

                                <svg viewBox="0 0 24 24"
                                     aria-hidden="true">

                                    <path d="M3 3l18 18" />

                                    <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8" />

                                    <path d="M9.9 4.2A10.8 10.8 0 0 1 12 4c5 0 9 4 10 8-0.4 1.5-1.2 2.8-2.3 4" />

                                    <path d="M6.2 6.2C4.5 7.4 3.4 9.2 2 12c1 4 5 8 10 8 1.3 0 2.5-.3 3.6-.8" />

                                </svg>

                            </button>

                        </div>

                        <span asp-validation-for="Password"
                              class="field-error">
                        </span>

                    </div>


                    <!-- Forgot password -->

                    <div class="form-options">

                        <label class="remember-me">

                            <input asp-for="RememberMe" />

                            <span>
                                Remember me
                            </span>

                        </label>

                        <a asp-controller="Account"
                           asp-action="ForgotPassword">

                            Forgot your password?

                        </a>

                    </div>


                    <!-- Login -->

                    <button type="submit"
                            class="login-button">

                        <span>
                            Log In
                        </span>

                        <span class="button-arrow">
                            →
                        </span>

                    </button>

                </form>


                <!-- Divider -->

                <div class="auth-divider">

                    <span></span>

                    <strong>or</strong>

                    <span></span>

                </div>


                <!-- Google -->

                <form asp-controller="Account"
                      asp-action="ExternalLogin"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="provider"
                           value="Google" />

                    <input type="hidden"
                           name="returnUrl"
                           value="@Model.ReturnUrl" />

                    <button type="submit"
                            class="google-button">

                        <svg viewBox="0 0 24 24"
                             aria-hidden="true">

                            <path fill="#4285F4"
                                  d="M21.35 12.27c0-.78-.07-1.54-.22-2.27H12v4.3h5.22a4.46 4.46 0 0 1-1.94 2.93v2.43h3.14c1.84-1.69 2.93-4.18 2.93-7.39Z" />

                            <path fill="#34A853"
                                  d="M12 21.7c2.63 0 4.84-.87 6.45-2.35l-3.14-2.43c-.87.58-1.98.92-3.31.92-2.54 0-4.69-1.72-5.46-4.03H3.3v2.5A9.74 9.74 0 0 0 12 21.7Z" />

                            <path fill="#FBBC05"
                                  d="M6.54 13.81A5.85 5.85 0 0 1 6.23 12c0-.63.11-1.24.31-1.81V7.69H3.3A9.75 9.75 0 0 0 2.25 12c0 1.57.38 3.05 1.05 4.31l3.24-2.5Z" />

                            <path fill="#EA4335"
                                  d="M12 6.16c1.43 0 2.71.49 3.72 1.46l2.79-2.79C16.84 3.22 14.63 2.3 12 2.3a9.74 9.74 0 0 0-8.7 5.39l3.24 2.5C7.31 7.88 9.46 6.16 12 6.16Z" />

                        </svg>

                        <span>
                            Continue with Google
                        </span>

                    </button>

                </form>


                <!-- Sign up -->

                <p class="signup-prompt">

                    Don't have an account?

                    <a asp-controller="Account"
                       asp-action="Register">

                        Sign Up

                    </a>

                </p>

            </div>


            <!-- Footer -->

            <footer class="auth-footer">

                <div>

                    <a href="#">
                        Privacy Policy
                    </a>

                    <span>|</span>

                    <a href="#">
                        Terms of Service
                    </a>

                    <span>|</span>

                    <a href="#">
                        Help
                    </a>

                </div>

                <p>
                    © 2026 StudentHub. All rights reserved.
                </p>

            </footer>

        </section>

    </main>


    <partial name="_ValidationScriptsPartial" />

    <script>

        const passwordInput =
            document.getElementById("passwordInput");

        const passwordToggle =
            document.getElementById("passwordToggle");

        passwordToggle?.addEventListener("click", function () {

            const isPassword =
                passwordInput.type === "password";

            passwordInput.type =
                isPassword ? "text" : "password";

            this.setAttribute(
                "aria-label",
                isPassword
                    ? "Hide password"
                    : "Show password"
            );

        });

    </script>

</body>
</html>