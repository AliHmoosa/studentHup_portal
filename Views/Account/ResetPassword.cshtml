@model StudentHub.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Reset Password - StudentHub</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" />

    <link rel="stylesheet"
          href="~/css/Login.css"
          asp-append-version="true" />

</head>

<body>

<main class="auth-page">

    <section class="auth-brand-panel">

        <div class="brand-background"></div>

        <div class="brand-content">

            <a class="brand-logo"
               asp-controller="Account"
               asp-action="Login">

                <span class="brand-icon">
                    🎓
                </span>

                <span class="brand-name">
                    Student<span>Hub</span>
                </span>

            </a>

            <p class="brand-tagline">
                Your Academic Journey In One Place
            </p>

            <div class="brand-introduction">

                <h1>
                    Plan. Learn.
                    <span>Achieve.</span>
                </h1>

                <p>
                    Keep your StudentHub account secure.
                </p>

            </div>

        </div>

    </section>


    <section class="auth-form-panel">

        <div class="login-card">

            <div class="login-heading">

                <h2>
                    Create New Password
                </h2>

                <p>
                    Enter your new StudentHub password below.
                </p>

            </div>


            <form asp-controller="Account"
                  asp-action="ResetPassword"
                  method="post"
                  class="login-form">

                @Html.AntiForgeryToken()

                <input asp-for="Email"
                       type="hidden" />

                <input asp-for="Token"
                       type="hidden" />


                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>


                <div class="form-group">

                    <label asp-for="Password">
                        New Password
                    </label>

                    <div class="input-wrapper">

                        <span class="input-icon">

                            <svg viewBox="0 0 24 24">

                                <rect x="5"
                                      y="10"
                                      width="14"
                                      height="10"
                                      rx="2" />

                                <path d="M8 10V7a4 4 0 0 1 8 0v3" />

                            </svg>

                        </span>

                        <input asp-for="Password"
                               type="password"
                               autocomplete="new-password"
                               placeholder="Enter your new password" />

                    </div>

                    <span asp-validation-for="Password"
                          class="field-error">
                    </span>

                </div>


                <div class="form-group">

                    <label asp-for="ConfirmPassword">
                        Confirm Password
                    </label>

                    <div class="input-wrapper">

                        <span class="input-icon">

                            <svg viewBox="0 0 24 24">

                                <rect x="5"
                                      y="10"
                                      width="14"
                                      height="10"
                                      rx="2" />

                                <path d="M8 10V7a4 4 0 0 1 8 0v3" />

                            </svg>

                        </span>

                        <input asp-for="ConfirmPassword"
                               type="password"
                               autocomplete="new-password"
                               placeholder="Confirm your new password" />

                    </div>

                    <span asp-validation-for="ConfirmPassword"
                          class="field-error">
                    </span>

                </div>


                <button type="submit"
                        class="login-button">

                    <span>
                        Reset Password
                    </span>

                    <span class="button-arrow">
                        →
                    </span>

                </button>

            </form>

        </div>

    </section>

</main>

<partial name="_ValidationScriptsPartial" />

</body>
</html>