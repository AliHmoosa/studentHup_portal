@{ ViewData["Title"] = "Add Assignment"; }
<section class="form-page"><a class="back-link" asp-action="Index">← Back to Assignments</a><h1>Add New Assignment</h1><p>Required fields are marked with an asterisk.</p><form class="form-card"><label>Assignment name *<input required placeholder="e.g. Clinical Case Reflection" /></label><label>Course *<select required><option>Select a course</option><option>Internal Medicine</option><option>Community Health</option></select></label><div class="form-row"><label>Due date *<input type="date" required /></label><label>Due time<input type="time" /></label></div><label>Priority<select><option>Medium</option><option>High</option><option>Low</option></select></label><label>Notes<textarea placeholder="Optional notes or instructions"></textarea></label><div class="form-actions"><a class="secondary-button" asp-action="Index">Cancel</a><button class="primary-button" type="submit">Save Assignment</button></div></form></section>
