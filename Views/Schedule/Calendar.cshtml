@{ ViewData["Title"] = "Calendar"; }
<section class="page-hero"><div><h1>Calendar</h1><p>Your classes, deadlines, exams, and personal events in one place.</p></div><a class="primary-button" href="#">＋ Add Personal Event</a></section>
<article class="calendar-full"><div class="calendar-toolbar"><button>‹</button><h2>September 2026</h2><button>›</button><span></span><button class="active-view">Month</button><button>Week</button><button>Day</button></div><div class="month-grid"><b>Sunday</b><b>Monday</b><b>Tuesday</b><b>Wednesday</b><b>Thursday</b><b>Friday</b><b>Saturday</b>@for(var day=1; day<=30; day++){<div class="month-day"><span>@day</span>@if(day == 15){<small class="event assignment">Clinical Case Reflection</small>}@if(day == 18){<small class="event exam">Midterm Exam</small>}@if(day == 21){<small class="event class-event">MED 410 · 8:00 AM</small>}</div>}</div></article>
