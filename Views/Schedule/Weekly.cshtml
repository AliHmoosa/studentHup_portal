@{ ViewData["Title"] = "Weekly Schedule"; var courses = new[]{("MED 410","Internal Medicine","Sunday, Tuesday","08:00 AM","10:30 AM","green"),("PHE 301","Community Health","Monday, Wednesday","11:00 AM","12:30 PM","blue"),("RES 220","Medical Research","Sunday, Thursday","01:00 PM","02:30 PM","amber"),("CLN 410","Clinical Skills","Tuesday, Thursday","03:00 PM","04:30 PM","purple")}; }
<section class="page-hero schedule-hero"><div><h1>Weekly Schedule</h1><p>Your class timetable for the selected semester. All class information is synced with My Courses.</p></div><span>Same classes.<br />A big week.</span></section>
<div class="schedule-toolbar"><button class="semester-button">▧ Semester 1 ⌄</button><button>‹</button><button>›</button><button>Today</button><span></span><button class="active-view">Week View</button><button>List View</button></div>
<div class="schedule-layout"><article class="schedule-grid"><div class="week-header"><b>Time</b><b>Sunday</b><b>Monday</b><b>Tuesday</b><b>Wednesday</b><b>Thursday</b></div>@for(var h=8;h<=18;h++){<div class="week-row"><time>@h:00</time>@for(var day=0;day<5;day++){<div class="slot">@if((h==8 && (day==0 || day==2)) || (h==11 && (day==1||day==3)) || (h==13 && (day==0||day==4)) || (h==15 && (day==2||day==4))){var course = h==8 ? courses[0] : h==11 ? courses[1] : h==13 ? courses[2] : courses[3];<div class="class-block @course.Item6"><strong>@course.Item1</strong><span>@course.Item2</span><small>@course.Item4 - @course.Item5</small></div>}</div>}</div>}</article><aside class="schedule-side"><h2>Today</h2><p>Monday, Sep 15, 2026</p>@foreach(var course in courses){<div class="course-item"><i class="dot @course.Item6"></i><div><strong>@course.Item1</strong><small>@course.Item2</small><small>@course.Item3 · @course.Item4</small></div></div>}<h2>Schedule Conflicts</h2><div class="success-box">✓ No conflicts<br /><small>Your schedule looks good!</small></div></aside></div>
